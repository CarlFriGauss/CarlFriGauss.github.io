{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gauss-website",
  "account_id": "4174faa5c2681549971b027bccf74a81",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "carlfriedrichgauss.com", "custom_domain": true },
    { "pattern": "preview.carlfriedrichgauss.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/write", "/write/*", "/essays/*", "/media/*"]
  },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "gauss-website-media" }],
  "vars": {
    "SITE_ORIGIN": "https://carlfriedrichgauss.com"
  },
  "observability": { "enabled": false }
}
